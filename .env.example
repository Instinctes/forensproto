# Copy to .env.local and restart the app.
# The server binds to 127.0.0.1 only (see npm scripts). Do not expose it.

# --- Auth (off by default — single-user local mode) ---
# FORENSPROTO_AUTH=enabled
# FORENSPROTO_ADMIN_USER=admin
# FORENSPROTO_ADMIN_PASSWORD=

# --- Recovery ---
# FORENSPROTO_MAX_CONCURRENT=1
# FORENSPROTO_JOB_RETENTION_DAYS=0

# --- Storage ---
# FORENSPROTO_DB=sqlite
# FORENSPROTO_DATA_DIR=

# --- Distributed / remote agents ---
# FORENSPROTO_EXECUTION_MODE=local
# FORENSPROTO_EXECUTION_MODE=agents

# --- Energy / cost estimates ---
# FORENSPROTO_GPU_WATTS=300
# FORENSPROTO_KWH_PRICE=0.30
# FORENSPROTO_CO2_G_PER_KWH=380

# --- Hashcat (Apple Silicon) ---
# FORENSPROTO_HASHCAT_BACKEND=metal
# FORENSPROTO_HASHCAT_SELFTEST=off
